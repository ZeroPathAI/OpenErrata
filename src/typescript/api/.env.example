# Local development configuration for the API server, worker, and selector.
# dotenv reads `.env` from the package directory, so copy this file to api/.env:
#   cp api/.env.example api/.env   (from src/typescript)
# Service values match the root docker-compose.yml.

DATABASE_URL="postgresql://openerrata:openerrata_dev@localhost:5433/openerrata"

# Instance OpenAI key. Required by the worker; the API server and selector
# start without it.
# OPENAI_API_KEY="sk-..."

OPENAI_MAX_RESPONSE_TOOL_ROUNDS=150
WORKER_CONCURRENCY=250
SELECTOR_DAILY_BUDGET=100
IP_RANGE_CREDIT_CAP=10

DATABASE_ENCRYPTION_KEY="dev-database-encryption-key-change-in-production"
DATABASE_ENCRYPTION_KEY_ID="primary"

BLOB_STORAGE_PROVIDER="s3_compatible"
BLOB_STORAGE_REGION="us-east-1"
BLOB_STORAGE_ENDPOINT="http://localhost:7070"
BLOB_STORAGE_BUCKET="openerrata-images"
BLOB_STORAGE_ACCESS_KEY_ID="openerrata_blob"
BLOB_STORAGE_SECRET_ACCESS_KEY="openerrata_blob_secret"
